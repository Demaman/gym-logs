# Copy to .env and fill in values before running docker compose.

DATABASE_URL=postgresql+asyncpg://gymlogs:gymlogs@postgres:5432/gymlogs
TEST_DATABASE_URL=postgresql+asyncpg://gymlogs:gymlogs@postgres:5432/gymlogs_test
REDIS_URL=redis://redis:6379

SECRET_KEY=changeme-generate-a-real-secret-before-running

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq alternative (free): AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
# OpenAI:                   AI_BASE_URL=  (leave blank)  AI_MODEL=gpt-4o-mini

# Media (uploaded exercise videos)
MEDIA_ROOT=/backend/media
MEDIA_BASE_URL=http://localhost:8000

