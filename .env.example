# Copy to .env and fill in values before running docker compose.

DATABASE_URL=postgresql+asyncpg://gymlogs:gymlogs@postgres:5432/gymlogs
TEST_DATABASE_URL=postgresql+asyncpg://gymlogs:gymlogs@postgres:5432/gymlogs_test
REDIS_URL=redis://redis:6379

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-before-running

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
